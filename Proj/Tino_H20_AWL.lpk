[Lista Istruzioni]

; Area Programma Principale : Iniziare ad inserire da QUI le Istruzioni del programma principale

; H20 v1.00 — corpo IL principale (tools/h20_apply_plan.py)
; Costanti con #. CMP sempre #. Somma = ESUB/LESUB da DATA.2030=0.
;
; H20 v1.00 — Compila in LogicPaint (solo Tino_H20_AWL.lpk; non risalvare il ladder sopra):
;   1. Compila — albero Pag.0 : HOME
;   2. KeyNotFound: togliere l'istruzione; analogica non nel file
;   3. Term_Ena_ANA=False nel file; DATA.417 ok su TP320 /SCT senza passi IDE
;   4. Trasmetti e confronta col ladder: emergenza, MAN, FILL, TRAVASO, Alr.0-5, SETUP EEPROM

; ----- Emergenza latch -----
	LD    FLAG.00
	AND   INP.01
	OUT   FLAG.01

	LD    FLAG.01
	OUT   OUT.04

; ----- Emergenza DOWN: spegne ricette e uscite -----
	LDNOT FLAG.01
	RES   FLAG.200
	RES   FLAG.201
	RES   FLAG.202
	RES   FLAG.203
	RES   FLAG.205
	RES   FLAG.206
	RES   FLAG.207
	RES   FLAG.208
	RES   FLAG.213
	RES   FLAG.228
	RES   FLAG.229
	RES   FLAG.234
	RES   FLAG.00
	RES   FLAG.238
	RES   FLAG.240
	RES   FLAG.241
	RES   FLAG.242
	RES   OUT.00
	RES   OUT.01
	RES   OUT.02
	RES   OUT.03

; ----- Allarmi INP -> DATA.08 bit 0-2 -----
; plc_comp: bit = costante con # (BSET 0,DATA.08 = Invalid OP)
	LD    INP.00
	BOUT  #0,DATA.08
	LDNOT INP.01
	BOUT  #1,DATA.08
	LD    INP.02
	BOUT  #2,DATA.08

	LD    INP.00
	RES   FLAG.200
	RES   FLAG.201
	RES   FLAG.202
	RES   FLAG.203
	RES   FLAG.205
	RES   FLAG.206
	RES   FLAG.207
	RES   FLAG.208
	RES   FLAG.213
	RES   FLAG.228
	RES   FLAG.229
	RES   FLAG.234
	RES   FLAG.00
	RES   FLAG.238
	RES   FLAG.240
	RES   FLAG.241
	RES   FLAG.242

; ----- Allarmi ricetta FLAG.210-212 / stallo 228-229 -----
	LD    FLAG.210
	BOUT  #3,DATA.08
	LD    FLAG.211
	BOUT  #4,DATA.08
	LD    FLAG.212
	BOUT  #5,DATA.08
	LD    FLAG.228
	BOUT  #6,DATA.08
	LD    FLAG.229
	BOUT  #7,DATA.08

; ----- Beep se qualsiasi allarme (0 < DATA.08) -----
	LD    SYS.01
	CMP   #0,DATA.08
	LD    SYS.04
	BOUT  #1,DATA.01

; ----- Primo avvio: SYS.02 e CIRC EEPROM=0 -----
	LD    SYS.02
	CMP   #0,DATA.4100
	LD    SYS.03
	OUT   FLAG.221

	LD    FLAG.221
	MOV   #450,DATA.4100
	MOV   #2500,DATA.4101
	MOV   #100,DATA.4102
	MOV   #2400,DATA.4103
	MOV   #16,DATA.4104
	MOV   #20,DATA.4105
	MOV   #3,DATA.4106
	MOV   #20,DATA.4107
	MOV   #1200,DATA.4108
	MOV   #800,DATA.4109
	MOV   #1100,DATA.4110
	MOV   #15,DATA.4111
	MOV   #330,DATA.4112
	MOV   #816,DATA.4113
	MOV   #20,DATA.4114
	MOV   #3,DATA.4115
	MOV   #0,DATA.4116
	MOV   #1000,DATA.2004
	MOV   #8,DATA.2005
	LD    SYS.02
	SET   FLAG.00
	LD    INP.03
	SET   FLAG.00
	LD    SYS.02
	CMP   #0,DATA.2004
	LD    SYS.02
	AND   SYS.03
	MOV   #1000,DATA.2004
	LD    SYS.02
	CMP   #0,DATA.2005
	LD    SYS.02
	AND   SYS.03
	MOV   #8,DATA.2005

	LD    SYS.01
	MOV   #0,DATA.2030

; ----- SMORZ SEC: EEPROM fuori 1-15 (vecchio %) -> 3 -----
	LD    SYS.01
	CMP   #15,DATA.4106
	LD    SYS.04
	MOV   #3,DATA.4106
	LD    SYS.01
	CMP   #1,DATA.4106
	LD    SYS.05
	MOV   #3,DATA.4106

; ----- Copia SETUP EEPROM -> runtime RAM -----
	LD    SYS.01
	MOV   DATA.4100,DATA.2011
	MOV   DATA.4101,DATA.2012
	MOV   DATA.4102,DATA.2013
	MOV   DATA.4103,DATA.2010
	MOV   DATA.4104,DATA.2014
	MOV   DATA.4105,DATA.2015
	MOV   DATA.4106,DATA.2016
	MOV   DATA.4107,DATA.2017
	MOV   DATA.4108,DATA.2018
	MOV   DATA.4109,DATA.2019
	MOV   DATA.4110,DATA.2021
	MOV   DATA.4111,DATA.2022
	MOV   DATA.4112,DATA.2006
	MOV   DATA.4113,DATA.2029
	MOV   DATA.4114,DATA.2033
	MOV   DATA.4115,DATA.2034
	MOV   DATA.4116,DATA.2044

	LD    SYS.01
	CMP   #3,DATA.4107
	LD    SYS.05
	MOV   #3,DATA.4107
	LD    SYS.01
	CMP   #20,DATA.4107
	LD    SYS.04
	MOV   #20,DATA.4107
	LD    SYS.01
	MOV   DATA.4107,DATA.2017
	CMP   #60,DATA.4116
	LD    SYS.04
	MOV   #60,DATA.4116
	LD    SYS.01
	MOV   DATA.4116,DATA.2044

; ----- Livello: ADC417 - ZERO, h_cm, AREA, LIV (LONG su 1200+) -----
; counts = ADC - ZERO in 2055; se ADC < ZERO clamp 0
	LD    SYS.01
	ESUB  DATA.2029,DATA.417,DATA.2055
	CMP   DATA.417,DATA.2029
	LD    SYS.04
	OUT   FLAG.214
	LD    FLAG.214
	MOV   #0,DATA.2055

; h_cm = counts * FS * 1020 / 3280 / 10
	LD    SYS.01
	MOV   DATA.2055,DATA.1220
	MOV   #0,DATA.1221
	MOV   DATA.2017,DATA.1222
	MOV   #0,DATA.1223
	LEMUL DATA.1220,DATA.1222,DATA.1200
	MOV   #1020,DATA.1222
	MOV   #0,DATA.1223
	LEMUL DATA.1200,DATA.1222,DATA.1202
	MOV   #3280,DATA.1220
	MOV   #0,DATA.1221
	LEDIV DATA.1220,DATA.1202,DATA.1204
	MOV   #10,DATA.1220
	MOV   #0,DATA.1221
	LEDIV DATA.1220,DATA.1204,DATA.1206
	MOV   DATA.1206,DATA.2001

; AREA = CIRC*CIRC*100/1257
	LD    SYS.01
	MOV   DATA.2011,DATA.1220
	MOV   #0,DATA.1221
	LEMUL DATA.1220,DATA.1220,DATA.1208
	MOV   #100,DATA.1222
	MOV   #0,DATA.1223
	LEMUL DATA.1208,DATA.1222,DATA.1210
	MOV   #1257,DATA.1220
	MOV   #0,DATA.1221
	LEDIV DATA.1220,DATA.1210,DATA.1212
	MOV   DATA.1212,DATA.2000

; LIV_g = OFFSET + h_cm * AREA / 1000
	LD    SYS.01
	MOV   DATA.2001,DATA.1220
	MOV   #0,DATA.1221
	MOV   DATA.2000,DATA.1222
	MOV   #0,DATA.1223
	LEMUL DATA.1220,DATA.1222,DATA.1214
	MOV   #1000,DATA.1220
	MOV   #0,DATA.1221
	LEDIV DATA.1220,DATA.1214,DATA.1216
	ESUB  DATA.2013,DATA.2030,DATA.2055
	ESUB  DATA.2055,DATA.1216,DATA.2028

; IIR 1 Hz: T-1 in 2056; seed se 2007=0 o T=1
	LD    SYS.01
	ESUB  #1,DATA.2016,DATA.2056
	CMP   #0,DATA.2007
	LD    SYS.03
	MOV   DATA.2028,DATA.2007
	LD    SYS.01
	CMP   #1,DATA.2016
	LD    SYS.03
	MOV   DATA.2028,DATA.2007

	LD    SYS.10
	MOV   DATA.2007,DATA.1220
	MOV   #0,DATA.1221
	MOV   DATA.2056,DATA.1222
	MOV   #0,DATA.1223
	LEMUL DATA.1220,DATA.1222,DATA.1208
	MOV   DATA.2028,DATA.1216
	MOV   #0,DATA.1217
	MOV   #0,DATA.1220
	MOV   #0,DATA.1221
	LESUB DATA.1208,DATA.1220,DATA.1222
	LESUB DATA.1222,DATA.1216,DATA.1212
	MOV   DATA.2016,DATA.1220
	MOV   #0,DATA.1221
	LEDIV DATA.1220,DATA.1212,DATA.1214
	MOV   DATA.1214,DATA.2007

	LD    SYS.01
	MOV   DATA.2007,DATA.1000

; % = LIV*100/LT_TOT
	LD    SYS.01
	MOV   DATA.1000,DATA.1220
	MOV   #0,DATA.1221
	MOV   #100,DATA.1222
	MOV   #0,DATA.1223
	LEMUL DATA.1220,DATA.1222,DATA.1218
	CMP   #0,DATA.2012
	LD    SYS.04
	OUT   FLAG.216
	LD    SYS.01
	MOV   DATA.2012,DATA.1220
	MOV   #0,DATA.1221
	LD    FLAG.216
	LEDIV DATA.1220,DATA.1218,DATA.1200
	LD    FLAG.216
	MOV   DATA.1200,DATA.2023
	LDNOT FLAG.216
	MOV   #0,DATA.2023
	LD    SYS.01
	CMP   #100,DATA.2023
	LD    SYS.04
	MOV   #100,DATA.2023

; ----- FLAG.210 target>allarme  FLAG.211 liv>allarme -----
	LD    SYS.01
	CMP   DATA.2004,DATA.2010
	LD    SYS.05
	OUT   FLAG.210
	LD    SYS.01
	CMP   DATA.2007,DATA.2010
	LD    SYS.05
	OUT   FLAG.211
	LD    FLAG.211
	RES   OUT.01
	RES   OUT.02
	RES   FLAG.205
	RES   FLAG.206
	LD    FLAG.200
	AND   FLAG.211
	RES   FLAG.201
	RES   FLAG.202
	RES   FLAG.208
	RES   FLAG.200

; ----- MAN lamp + falling edge kill -----
	LD    FLAG.204
	MOV   #1,DATA.2020
	LDNOT FLAG.204
	MOV   #0,DATA.2020
	RES   FLAG.205
	RES   FLAG.206
	RES   FLAG.207

	LD    FLAG.209
	ANDNOT FLAG.204
	RES   OUT.00
	RES   OUT.01
	RES   OUT.02
	RES   OUT.03
	RES   FLAG.200
	RES   FLAG.201
	RES   FLAG.202
	RES   FLAG.203
	RES   FLAG.205
	RES   FLAG.206
	RES   FLAG.207
	RES   FLAG.208
	RES   FLAG.213
	RES   FLAG.228
	RES   FLAG.229
	RES   FLAG.234

	LD    FLAG.204
	OUT   FLAG.209

; abort FILL se 210 o MAN; mutua esclusione TRAVASO
	LD    FLAG.200
	AND   FLAG.210
	RES   FLAG.200
	LD    FLAG.210
	RES   FLAG.201
	RES   FLAG.202
	RES   FLAG.208
	LD    FLAG.200
	AND   FLAG.204
	RES   FLAG.200
	LD    FLAG.203
	AND   FLAG.204
	RES   FLAG.203
	LD    FLAG.200
	RES   FLAG.203

; STOP FILL fronte 200: RES 201/202/208
	LD    FLAG.239
	ANDNOT FLAG.200
	RES   FLAG.201
	RES   FLAG.202
	RES   FLAG.208
	LD    FLAG.200
	OUT   FLAG.239

; ----- REFILL: AVVIA FLAG.238 -----
	LD    SYS.01
	ESUB  DATA.2013,DATA.2030,DATA.2055
	ESUB  DATA.2055,DATA.2015,DATA.2059
	RES   FLAG.251
	CMP   DATA.2007,DATA.2059
	LD    SYS.04
	SET   FLAG.251
	LD    SYS.01
	CMP   DATA.2007,DATA.2059
	LD    SYS.03
	SET   FLAG.251

	LD    FLAG.238
	AND   FLAG.210
	RES   FLAG.238

	LD    FLAG.238
	AND   FLAG.251
	ANDNOT FLAG.210
	SET   FLAG.200
	RES   FLAG.240
	RES   FLAG.242
	RES   FLAG.238

	LD    FLAG.238
	ANDNOT FLAG.251
	ANDNOT FLAG.210
	MOV   DATA.00,DATA.2060
	SET   FLAG.240
	RES   FLAG.242
	CMP   #1,DATA.00
	LD    FLAG.238
	ANDNOT FLAG.251
	ANDNOT FLAG.210
	AND   SYS.03
	MOV   #14,DATA.00
	LD    FLAG.238
	ANDNOT FLAG.251
	ANDNOT FLAG.210
	CMP   #8,DATA.00
	LD    FLAG.238
	ANDNOT FLAG.251
	ANDNOT FLAG.210
	AND   SYS.03
	MOV   #15,DATA.00
	LD    FLAG.238
	ANDNOT FLAG.251
	ANDNOT FLAG.210
	RES   FLAG.238

	LD    FLAG.240
	CMP   #1,DATA.00
	LD    FLAG.240
	AND   SYS.03
	RES   FLAG.242
	RES   FLAG.240
	LD    FLAG.240
	CMP   #8,DATA.00
	LD    FLAG.240
