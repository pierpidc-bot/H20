	RES   FLAG.236
	LD    FLAG.237
	MOV   #0,DATA.4124
	MOV   #0,DATA.4125
	SET   FLAG.220
	RES   FLAG.237

; ----- Salva EEPROM 4100-4125 via SYS.20 -----
	LD    FLAG.220
	MOV   #4100,DATA.8142
	MOV   #4125,DATA.8143
	MOV   #4100,DATA.58
	MOV   #4125,DATA.59
	SET   SYS.20
	RES   FLAG.220

	END

	SBR   INITIALIZE

; Subroutine INITIALIZE (eseguita all'avvio) : Aggiungere QUI le ABILITAZIONI e le impostazioni iniziali

	LD    SYS.01
	SET   FLAG.00

	ENDSBR

; Area Subroutine : Inserire QUI eventuali Subroutine (struttura "SBR" ... "ENDSBR")


