[Network_0000]
Net_0000_Nome=Net.0
Net_0000_Titolo=Area Programma Principale
Net_0000_Commento=H20 v1.00: emergenza, livello, MAN, FILL, TRAVASO, REFILL
Net_0000_Mascherato=False
Net_0000_Read_Only=False
Net_0000_Dimensione_X=9
Net_0000_Dimensione_Y=1809
Net_0000_CLine_0000=Emergenza latch
Net_0000_CLine_0005=Emergenza DOWN: spegne ricette e uscite
Net_0000_CLine_0100=Solo emergenza su DATA.08 (pagina Alr blocca il touch)
Net_0000_CLine_0103=INP.00 termico: pompa e ricette off
Net_0000_CLine_0183=Beep se emergenza (DATA.08)
Net_0000_CLine_0189=EEPROM virgin: CIRC=0 o FFFF (ogni scan)
Net_0000_CLine_0266=SMORZ SEC: EEPROM fuori 1-15 (vecchio %) -> 3
Net_0000_CLine_0276=DUR RETE decimi 51-500 -> intero; 0 o >500 -> 24 (SYS.02)
Net_0000_CLine_0298=Copia SETUP EEPROM -> runtime RAM
Net_0000_CLine_0332=Clamp FS 3..20 e TIMEOUT 0..60
Net_0000_CLine_0351=Livello: ADC417 - ZERO, h_cm, AREA, LIV (LONG solo su 1200+)
Net_0000_CLine_0521=FLAG.210 target>allarme  FLAG.211 liv>allarme
Net_0000_CLine_0544=HMI pulse SETFLG/RESFLG -> invert MAN/OSM/RETE/TRAV on rising edge
Net_0000_CLine_0609=MAN lamp + falling edge kill
Net_0000_CLine_0669=STOP FILL impulso 198; fronte 200: RES 201/202/208
Net_0000_CLine_0675=RESET FILL impulso 268: RES 200/240 (non FLAG.00)
Net_0000_CLine_0692=REFILL: vuoto=FILL, sennò pagina; SI mix rabbocco
Net_0000_CLine_0887=Mix Vo/Vn 32bit
Net_0000_CLine_1096=FILL sequenza
Net_0000_CLine_1203=TRAVASO
Net_0000_CLine_1225=TRAVASO AVVIA/STOP impulso HMI 196/197
Net_0000_CLine_1282=2026 = calo solo se LIV non e' salito (niente wrap → fine finta)
Net_0000_CLine_1313=LIV <= OFFSET -> FLAG.243
Net_0000_CLine_1326=TRAVASO coda OFFSET: init t_s poi SET 234
Net_0000_CLine_1423=Fine TRAVASO: rest coda una volta, poi SET 220 e RES 203/234
Net_0000_CLine_1449=Watchdog stallo TIMEOUT (non MAN, non STAB, non coda)
Net_0000_CLine_1611=Uscite auto/man: OSM Q2, RETE Q3, TRAV Q0
Net_0000_CLine_1642=LED specchio RAM 2040+
Net_0000_CLine_1657=FLOW = LTH L/m SETUP; ETA = residuo/LTH
Net_0000_CLine_1689=Totalizzatori dL su LONG EEPROM 4120+
Net_0000_CLine_1765=AZZERA totali (fronte HMI SETFLG/RESFLG)
Net_0000_CLine_1796=Salva EEPROM 4100-4125 via SYS.20
